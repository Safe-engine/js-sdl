{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./engine",
    "outDir": "lib",
    "declaration": true,
    "sourceMap": true,
    "typeRoots": [
      "./node_modules/@types",
      "./@types"
    ],
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "sdl3": [
        "./engine/sdl3.ts"
      ],
      "box2d": [
        "./engine/physics/box2d.ts"
      ]
    }
  },
  "exclude": [
    "@types/package.d.ts"
  ],
  "include": [
    "engine",
    "@types"
  ]
}